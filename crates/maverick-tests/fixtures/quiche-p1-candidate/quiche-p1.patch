+fn reject_peer_push_activity<F: BufFactory, T>(
+    conn: &mut super::Connection<F>,
+) -> Result<T> {
+    conn.close(true, Error::FrameUnexpected.to_wire(), b"")?;
+
+    Err(Error::FrameUnexpected)
+}
